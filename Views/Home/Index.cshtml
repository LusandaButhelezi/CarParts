@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@{
    ViewData["Title"] = "Home";
}

<div id="Content" class="container">

    @*-- **** Banner **** --*@
    <div id="Banner">
        <p>Best Cars</p>
        <p>Rent a luxury, family or small car <br />at a great price with us!</p>
        <a href="" role="button">Book now!</a>
    </div> @*-- Banner end --*@

    @*-- **** Fees **** --*@
    <div id="Fees">
        <div>
            <h2>Get what you pay for</h2>
            <ul>
                <li>
                    Included in our daily rental fee:
                    <ul>
                        <li>Various free kilometres a day</li>
                        <li>Standard or super collision damage waiver</li>
                        <li>Standard or super theft loss waiver</li>
                        <li>Airport surcharge (if applicable)</li>
                        <li>Tourism levy and VAT (if applicable)</li>
                    </ul>
                </li>
                <li>
                    Excluded:
                    <ul>
                        <li>Contract fee</li>
                        <li>Fuel</li>
                        <li>Responsibility amount in event of an accident or theft</li>
                        <li>Additional driver fee</li>
                        <li>Delivery and collection</li>
                        <li>Windscreen and tyre damage waiver</li>
                        <li>Excess kilometre charges</li>
                        <li>Any other additional service charges applicable</li>
                    </ul>
                </li>
            </ul>
        </div>
        <div>
            <img src="~/images/SilverCar.jpg" alt="Silver car"  />
        </div>
    </div> @*-- Fees end --*@

    @*-- **** Booking **** --*@
    <div id="Booking">
        <h1>Car Rental Booking</h1>
        <p>
            Please use the booking form below to make a car rental reservation.
            One of our consultants
            will then contact your to confirm the details of your reservation.
        </p>

        <form method="post" action="">
            
                <div class="mb-3">
                <label for="name" class="form-label">  Name &amp; Surname:</label>
                    <input type="text" class="form-control" id="name" />
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">E-mail address:</label>
                    <input type="email" class="form-control" id="email" />
                </div>

                <div class="mb-3">
                    <label for="address" class="form-label">Postal address:</label>

                <textarea rows="3"></textarea>

            </div>


            <p>
                From which Car Group would you like to rent:<br />
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="carGroup" id="groupA" />
                    <label class="form-check-label" for="groupA">Group A (e.g. Hyundai i10)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="carGroup" id="groupB" />
                    <label class="form-check-label" for="groupB">Group B (e.g. VW Polo)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="carGroup" id="other" />
                    <label class="form-check-label" for="other">Other</label>
                </div>
  

            </p>

            <div>
                <div>
                    <label>
                        Pick up date:
                    </label>
                </div>
                <div>
                    <select name="pickup_day">
                        <option>1</option>
                        <option>2</option>
                        <option>3</option>
                        <option>4</option>
                        <option>5</option>
                        <option>6</option>
                        <option>7</option>
                        <option>8</option>
                        <option>9</option>
                        <option>10</option>
                        <option>11</option>
                        <option>12</option>
                        <option>13</option>
                        <option>14</option>
                        <option>15</option>
                        <option>16</option>
                        <option>17</option>
                        <option>18</option>
                        <option>19</option>
                        <option>20</option>
                        <option>21</option>
                        <option>22</option>
                        <option>23</option>
                        <option>24</option>
                        <option>25</option>
                        <option>26</option>
                        <option>27</option>
                        <option>28</option>
                        <option selected>29</option>
                        <option>30</option>
                        <option>31</option>
                    </select>
                </div>
                <div>
                    <select name="pickup_month" >
                        <option>January</option>
                        <option>February</option>
                        <option>March</option>
                        <option>April</option>
                        <option>May</option>
                        <option>June</option>
                        <option>July</option>
                        <option selected>August</option>
                        <option>September</option>
                        <option>October</option>
                        <option>November</option>
                        <option>December</option>
                    </select>
                </div>
                <div>
                    <select name="pickup_year">
                        <option>2024</option>
                        <option>2025</option>
                    </select>
                </div>
            </div>

            <p>
                <input type="submit" value="Send" />
                <input type="reset" value="Clear" />
            </p>
        </form>
    </div> @*-- Booking end --*@

</div> @*-- Content container end --*@



